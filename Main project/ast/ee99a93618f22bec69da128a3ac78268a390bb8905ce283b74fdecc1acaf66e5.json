b.jsx", "source_location": "L516"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "(() => {\r\n                                const url = blueprintData.imageUrl;\r\n                                if (!url) return null;\r\n\r\n                                const isCloudinary = url.includes('cloudinary.com');\r\n                                const isPdf = url.toLowerCase().split('?')[0].endsWith('.pdf');\r\n\r\n                                // Cloudinary page-specific URL:\r\n                                // Changes .../upload/v123/... to .../upload/pg_2/v123/...\r\n                                let displayUrl = url;\r\n                                if (isCloudinary && isPdf) {\r\n                                    displayUrl = url.replace('/upload/', `/upload/pg_${currentPage}/`).replace(/\\.pdf$/i, '.jpg');\r\n                                }\r\n\r\n                                return (\r\n                                    <div className=\"relative\">\r\n                                        {/* Visible Image Layer */}\r\n                                        <img\r\n                                            ref={imageRef}\r\n                                            src={displayUrl}\r\n                                            alt={`Project Blueprint Page ${currentPage}`}\r\n                                            className=\"w-full h-auto block pointer-events-none\"\r\n                                            onLoad={() => setPdfPageLoading(false)}\r\n                                            onError={(e) => {\r\n                                                console.error(\"Failed to load blueprint page image\");\r\n                                                // If a page fails to load, go back to previous page\r\n                                                if (currentPage > 1) {\r\n                                                    setNumPages(currentPage - 1);\r\n                                                    setCurrentPage(prev => prev - 1);\r\n                                                }\r\n                                                setPdfPageLoading(false);\r\n                                            }}\r\n                                        />\r\n\r\n                                        {/* Loading Overlay */}\r\n                                        {pdfPageLoading && (\r\n                                            <div className=\"absolute inset-0 flex items-center justify-center bg-white/80 z-10 backdrop-blur-sm\">\r\n                                                <div className=\"flex flex-col items-center\">\r\n                                                    <Loader2 className=\"animate-spin text-violet-500 mb-2\" size={32} />\r\n                                                    <span className=\"text-sm font-medium text-gray-500\">Loading Blueprint...</span>\r\n                                                </div>\r\n                                            </div>\r\n                                        )}\r\n                                    </div>\r\n                                );\r\n                            })", "is_member_call": false, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L528"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "map", "is_member_call": true, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L584"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "filter", "is_member_call": true, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L584"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "filter", "is_member_call": true, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L638"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "map", "is_member_call": true, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L644"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "filter", "is_member_call": true, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L644"}, {"caller_nid": "components_blueprinttab_blueprinttab", "callee": "filter", "is_member_call": true, "source_file": "D:\\SR Associates\\frontend\\src\\components\\BlueprintTab.jsx", "source_location": "L687"}]}