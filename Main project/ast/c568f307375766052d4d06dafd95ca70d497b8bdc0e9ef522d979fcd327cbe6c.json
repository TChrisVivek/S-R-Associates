 percentage: pct\r\n                    };\r\n                }).sort((a, b) => b.percentage - a.percentage);\r\n            } else {\r\n                return projectUtilization.map(p => ({\r\n                    id: p.id,\r\n                    name: p.name,\r\n                    status: p.status,\r\n                    budgetFormatted: p.budgetFormatted,\r\n                    spentFormatted: p.spentFormatted,\r\n                    percentage: p.percentage\r\n                }));\r\n            }\r\n        })", "is_member_call": false, "source_file": "D:\\SR Associates\\backend\\controllers\\budgetController.js", "source_location": "L185"}, {"caller_nid": "controllers_budgetcontroller_getbudgetdashboard", "callee": "await", "is_member_call": false, "source_file": "D:\\SR Associates\\backend\\controllers\\budgetController.js", "source_location": "L185"}, {"caller_nid": "controllers_budgetcontroller_getbudgetdashboard", "callee": "json", "is_member_call": true, "source_file": "D:\\SR Associates\\backend\\controllers\\budgetController.js", "source_location": "L223"}, {"caller_nid": "controllers_budgetcontroller_getbudgetdashboard", "callee": "error", "is_member_call": true, "source_file": "D:\\SR Associates\\backend\\controllers\\budgetController.js", "source_location": "L234"}, {"caller_nid": "controllers_budgetcontroller_getbudgetdashboard", "callee": "json", "is_member_call": true, "source_file": "D:\\SR Associates\\backend\\controllers\\budgetController.js", "source_location": "L235"}, {"caller_nid": "controllers_budgetcontroller_getbudgetdashboard", "callee": "status", "is_member_call": true, "source_file": "D:\\SR Associates\\backend\\controllers\\budgetController.js", "source_location": "L235"}]}